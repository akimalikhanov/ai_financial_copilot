# Keys only, empty values — COMMITTED. Real values live in the gitignored app.env,
# generated by `make k8s-secrets`. AWS_* is written by Phase 9 (copied from garage.env's
# pre-generated S3 key pair). Phase 10 (app tier) adds the rest: JWT_SECRET, LLM provider
# keys, DB/Redis creds duplicated here for the api container's single secretRef, and the
# Langfuse keypair (values TBD until Phase 16 wires Langfuse — leave blank until then).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
JWT_SECRET=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
APP_DB_USER=
APP_DB_PASSWORD=
REDIS_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
