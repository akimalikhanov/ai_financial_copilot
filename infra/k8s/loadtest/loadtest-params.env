# Scenario knobs for one load-test run. `make k8s-loadtest` rewrites the LOADTEST_* values
# below from its own variables before applying, so edits here are defaults only.
# See docs/notes/loadtest-concepts.md §8 for the T-series scenario settings.
LOADTEST_TARGET_HOST=http://api:8000
LOADTEST_USERS=20
LOADTEST_SPAWN_RATE=20
LOADTEST_DURATION=90m
LOADTEST_CHAT_MODEL=gpt-4o-mini
LOADTEST_MIN_WAIT=180
LOADTEST_MAX_WAIT=300
# "ask" (default) = the question-asking profile; "sse_hold" = T3, open one stream per user and
# hold it; "upload" = the ingestion track (T11-T13). Selects the locustfile's user class; they
# are mutually exclusive.
LOADTEST_MODE=upload
# Ingestion track (docs/notes/loadtest-readiness-audit.md §8). Only read when MODE=upload.
# The directory is the fixtures PVC mount; populate it with `make loadtest-fixtures`.
LOADTEST_FIXTURE_DIR=/fixtures/backlog
# Comma-separated fixture filenames, or empty for "everything in the directory". The classes
# differ ~4x in service time, so 2.1 (S for one class) and 2.2 (queue curve, constant S) both
# pin this to one file; leaving it empty averages the mix and measures nothing in particular.
LOADTEST_FIXTURES=
# 1 upload per user, so `-u 20` is §8 item 2.2's 20-document backlog rather than an
# open-ended loop measuring how fast the client outruns one ingestion slot.
LOADTEST_UPLOADS_PER_USER=1
LOADTEST_UPLOAD_MIN_WAIT=0
LOADTEST_UPLOAD_MAX_WAIT=0
# Per-document client timeout, so it must cover the whole QUEUE, not one parse: at one slot the
# last of 20 documents waits behind all 19. Above INGEST_TASK_TIME_LIMIT_SECONDS=2700 so a real
# server-side kill is still attributed to the server. T13 lowers the *server's* parse timeout.
LOADTEST_INGEST_TIMEOUT_S=3600
# T3 hold length. Default exceeds any plausible -t so the run duration bounds the hold.
LOADTEST_HOLD_FOR_S=86400
# Empty = flat -u/-r/-t (every scenario except T2/T4); "ramp" activates RampShape and "spike"
# activates SpikeShape in infra/loadtest/locustfile.py. Either shape reads its own knobs below
# and ignores LOADTEST_USERS/LOADTEST_SPAWN_RATE/LOADTEST_DURATION.
LOADTEST_SHAPE=
LOADTEST_RAMP_INITIAL_USERS=1
LOADTEST_RAMP_STEP_USERS=2
LOADTEST_RAMP_STEP_SECONDS=30
LOADTEST_RAMP_MAX_USERS=60
LOADTEST_RAMP_SPAWN_RATE=10
# T4 (spike): jump to _USERS over _SPAWN_SECONDS, then hold _HOLD at that plateau.
LOADTEST_SPIKE_USERS=50
LOADTEST_SPIKE_SPAWN_SECONDS=10
LOADTEST_SPIKE_HOLD=2m
