# Non-secret app tuning knobs, mirrored from .env.example (everything that isn't a
# credential and isn't an in-cluster host/port — those two live in app-endpoints, see
# api-deployment.yaml). Committed; edit alongside .env.example when either drifts.

# Chunking
CHUNKING_TOKENIZER_MODEL=BAAI/bge-m3
CHUNKING_MAX_TOKENS=900
CHUNKING_MIN_TOKENS=100
CHUNKING_MAX_MERGE_MULTIPLIER=3.0
DOCLING_GENERATE_PICTURE_IMAGES=true
# Code default is the 256M variant; .env.example pins 500M.
DOCLING_PICTURE_VLM_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct

# Chat history tail
CHAT_TAIL_TTL=1800
CHAT_TAIL_MAX_MESSAGES=50

# Retrieval
VECTOR_SEARCH_TOP_K=50
KEYWORD_SEARCH_TOP_K=50
FUSE_RRF_K=20
FUSE_RRF_FINAL_TOP_K=50
FUSE_RRF_VECTOR_WEIGHT=0.4
FUSE_RRF_KEYWORD_WEIGHT=0.6
ENTITY_SIMILARITY_THRESHOLD=0.5
EMBED_MODEL_ID=BAAI/bge-m3
# Must be set: defaults to "local", which silently embeds on CPU via SentenceTransformer
# instead of calling TEI — ~50x slower and OOMs the ingestion worker.
EMBEDDING_PROVIDER=tei

# Reranker (TEI cross-encoder; base URL comes from app-endpoints)
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=10.0
RERANKER_TOP_K=8
RERANKER_MAX_INPUT=50

# Agent loop
AGENT_TOOL_MODEL=gpt-5-mini
AGENT_HISTORY_TURNS=2
AGENT_HISTORY_ASSISTANT_TOKENS=600
AGENT_MAX_PLAN_ITEMS=8
AGENT_MAX_REVIVALS_PER_TURN=3
AGENT_DEADLINE_SECONDS=180

# Celery
CELERY_VISIBILITY_TIMEOUT_SECONDS=2400
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
CELERY_TASK_TIME_LIMIT_SECONDS=1200
INGEST_MAX_ATTEMPTS=2
# Both required: Celery defaults to os.cpu_count(), which ignores cgroup limits and
# reports the node's 20 cores -> 20 prefork children -> OOMKill.
CELERY_CHAT_WORKER_CONCURRENCY=4
CELERY_WORKER_CONCURRENCY=2

# Prompt-injection scanning
INJECTION_SCAN_USER_INPUT=true
INJECTION_SCAN_CHUNKS=true

# Object storage (Garage S3) — bucket names and region; endpoint URL is in app-endpoints
AWS_DEFAULT_REGION=garage
S3_BUCKET=pdfs
S3_RAW_BUCKET=pdfs
S3_DOCLING_BUCKET=docling
S3_RENDERED_BUCKET=rendered
S3_CHUNKS_BUCKET=chunks

# Table summarizer
TABLE_SUMMARIZER_MODEL=qwen3-8b
TABLE_SUMMARIZER_ENABLED=False

# Conversation naming
CONVERSATION_NAMING_ENABLED=true

# Auth / cookies
COOKIE_SECURE=false
JWT_EXPIRATION_TIME=600m
JWT_REFRESH_TIME=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
