# Non-secret app tuning knobs, mirrored from .env.example (everything that isn't a
# credential and isn't an in-cluster host/port — those two live in app-endpoints, see
# api-deployment.yaml). Committed; edit alongside .env.example when either drifts.

# Chunking
CHUNKING_TOKENIZER_MODEL=BAAI/bge-m3
CHUNKING_MAX_TOKENS=900
CHUNKING_MIN_TOKENS=100
CHUNKING_MAX_MERGE_MULTIPLIER=3.0
# Lean parse config (docs/stages/ingestion-optimization-implementation.md Phase 4): drop
# EasyOCR and the inline SmolVLM captioner, keep picture crops + classification for the
# Phase 11 enricher. Requires Phase 2 (chunker drops "<!-- image -->" placeholders cleanly).
DOCLING_DO_OCR=false
DOCLING_DO_PICTURE_DESCRIPTION=false
DOCLING_GENERATE_PAGE_IMAGES=false
DOCLING_GENERATE_PICTURE_IMAGES=true
DOCLING_IMAGES_SCALE=1.5
# Wall-clock ceiling on the whole parse. DOCLING_DOCUMENT_TIMEOUT bounds the page loop only;
# assembly, reading order and enrichment run outside it.
DOCLING_PARSE_TIMEOUT_SECONDS=600
# Re-parse with forced full-page OCR when a parse yields garbled text (broken font encoding:
# see docs/stages/ingestion-optimization-implementation.md Phase 8). Plain DOCLING_DO_OCR does
# not cover this — Docling only OCRs regions lacking a text layer, and these PDFs have one.
DOCLING_OCR_FALLBACK_ENABLED=true
DOCLING_TEXT_QUALITY_THRESHOLD=0.02
# Page-loop timeout for the OCR fallback only: full-page OCR runs ~4.3s/page vs ~0.6s.
DOCLING_OCR_DOCUMENT_TIMEOUT=1800
# Dead while DOCLING_DO_PICTURE_DESCRIPTION=false; kept for Phase 11, which routes through
# llm_router instead of Docling's inline VLM. Code default is the 256M variant; .env.example
# pins 500M.
DOCLING_PICTURE_VLM_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct
# Populated by model-preload-job.yaml (docling-tools models download); docling_parser.py
# points the pipeline here instead of falling back to HF_HOME's lazy per-repo download.
DOCLING_ARTIFACTS_PATH=/home/appuser/.cache/huggingface/docling-models
# HF's xet transfer backend collapses to ~1KB/s from inside the cluster (many small CAS
# range requests); plain HTTP to the same host sustains ~4MB/s. See model-preload-job.yaml.
HF_HUB_DISABLE_XET=1

# Chat history tail
CHAT_TAIL_TTL=1800
CHAT_TAIL_MAX_MESSAGES=50

# Retrieval
VECTOR_SEARCH_TOP_K=50
KEYWORD_SEARCH_TOP_K=50
FUSE_RRF_K=20
FUSE_RRF_FINAL_TOP_K=50
FUSE_RRF_VECTOR_WEIGHT=0.4
FUSE_RRF_KEYWORD_WEIGHT=0.6
ENTITY_SIMILARITY_THRESHOLD=0.5
EMBED_MODEL_ID=BAAI/bge-m3
# Must be set: defaults to "local", which silently embeds on CPU via SentenceTransformer
# instead of calling TEI — ~50x slower and OOMs the ingestion worker.
EMBEDDING_PROVIDER=tei
# Inputs per request; clamped at runtime to TEI's --max-client-batch-size (tei-embedder-deployment).
EMBEDDER_BATCH_SIZE=64
# In-flight requests per embed call. TEI's --max-concurrent-requests (512) is the hard ceiling.
EMBEDDER_CONCURRENCY=4

# Reranker (TEI cross-encoder; base URL comes from app-endpoints)
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_SECONDS=10.0
RERANKER_TOP_K=8
RERANKER_MAX_INPUT=50

# Agent loop
AGENT_TOOL_MODEL=gpt-5-mini
AGENT_HISTORY_TURNS=2
AGENT_HISTORY_ASSISTANT_TOKENS=600
AGENT_MAX_PLAN_ITEMS=8
AGENT_MAX_REVIVALS_PER_TURN=3
AGENT_DEADLINE_SECONDS=180

# Celery
CELERY_VISIBILITY_TIMEOUT_SECONDS=2400
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
CELERY_TASK_TIME_LIMIT_SECONDS=1200
INGEST_MAX_ATTEMPTS=2
# Both required: Celery defaults to os.cpu_count(), which ignores cgroup limits and
# reports the node's 20 cores -> 20 prefork children -> OOMKill.
CELERY_CHAT_WORKER_CONCURRENCY=4
CELERY_WORKER_CONCURRENCY=1

# Prompt-injection scanning
INJECTION_SCAN_USER_INPUT=true
INJECTION_SCAN_CHUNKS=true

# Object storage (Garage S3) — bucket names and region; endpoint URL is in app-endpoints
AWS_DEFAULT_REGION=garage
S3_BUCKET=pdfs
S3_RAW_BUCKET=pdfs
S3_DOCLING_BUCKET=docling
S3_RENDERED_BUCKET=rendered
S3_CHUNKS_BUCKET=chunks
S3_PICTURES_BUCKET=pictures

# Table summarizer
TABLE_SUMMARIZER_MODEL=qwen3-8b
TABLE_SUMMARIZER_ENABLED=False

# Conversation naming
CONVERSATION_NAMING_ENABLED=true

# Auth / cookies
COOKIE_SECURE=false
JWT_EXPIRATION_TIME=600m
JWT_REFRESH_TIME=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM tracing. Defaults to false in code — without this the app never sends traces to
# Langfuse; host/keys come from app-endpoints and app-secret.
LANGFUSE_ENABLED=true
