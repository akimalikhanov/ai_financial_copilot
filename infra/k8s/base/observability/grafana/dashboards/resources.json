          ]
        }
      }
    },
    {
      "id": 17,
      "title": "OpenSearch / Qdrant Container Memory",
      "type": "timeseries",
      "description": "Migrated from API Overview, widened to cover Qdrant too — both are JVM/heap-shaped workloads whose working set sits near their limit by design.",
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"copilot\", pod=~\"opensearch-.*|qdrant-.*\", container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}}"
        },
        {
          "expr": "sum(container_spec_memory_limit_bytes{namespace=\"copilot\", pod=~\"opensearch-.*|qdrant-.*\", container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}} limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*limit$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "GPU (kind only — dcgm-exporter DaemonSet)",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 19,
      "title": "GPU Utilization",
      "type": "timeseries",
