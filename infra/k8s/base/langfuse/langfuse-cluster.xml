<clickhouse>
    <!-- Built-in Keeper (ZooKeeper-compatible coordinator for ReplicatedMergeTree) -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>localhost</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <!-- Point ZooKeeper client at the built-in Keeper -->
    <zookeeper>
        <node>
            <host>localhost</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <!-- Single-node cluster named "default" — required by Langfuse ON CLUSTER migrations.

         The host MUST be the pod's headless-Service DNS name, not the `clickhouse` Service
         name compose uses. ClickHouse decides whether a replica is itself by resolving <host>
         and comparing against its own interface addresses; the ClusterIP Service resolves to a
         VIP (10.96.x.x), never the pod IP, so system.clusters reports is_local=0 and *nobody*
         claims the entries in /clickhouse/task_queue/ddl. Langfuse's boot then dies with
         "Distributed DDL task ... is not finished on 1 of 1 hosts" after a 180s timeout.
         The headless name resolves straight to the pod IP, which matches. -->
    <remote_servers>
        <default>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse-0.clickhouse-headless.copilot.svc.cluster.local</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>

    <!-- Macros used by ReplicatedMergeTree table engine -->
    <macros>
        <shard>01</shard>
        <replica>clickhouse-0</replica>
    </macros>
</clickhouse>
