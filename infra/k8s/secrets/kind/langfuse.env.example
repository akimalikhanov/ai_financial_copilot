# Keys only, empty values — COMMITTED. Real values live in the gitignored langfuse.env,
# generated by `make k8s-secrets` (stage-17 plan Phase 16), mirroring what
# infra/scripts/langfuse_bootstrap.sh generates for the compose stack.

# Postgres direct, NOT via PgBouncer: Prisma migrations need session mode.
DATABASE_URL=
# ClickHouse native protocol, used only for migrations (queries go over CLICKHOUSE_URL).
CLICKHOUSE_MIGRATION_URL=
REDIS_AUTH=

NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=

# First-boot seed: Langfuse creates the org/project/user itself when these are set, so no
# separate seed Job. The PROJECT keys are the same pair the app sends as
# LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY in app.env — they must stay identical.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
